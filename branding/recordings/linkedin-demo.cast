[27.83726, "o", "\u001b[31m╭─\u001b[0m\u001b[31m────────────────────────────────────────\u001b[0m\u001b[31m \u001b[0m\u001b[1;36mscan complete\u001b[0m\u001b[31m \u001b[0m\u001b[31m─────────────────────────────────────────\u001b[0m\u001b[31m─╮\u001b[0m\r\n\u001b[31m│\u001b[0m \u001b[1mstatus:\u001b[0m  \u001b[1;31mVULNERABLE\u001b[0m                                                                              \u001b[31m│\u001b[0m\r\n\u001b[31m│\u001b[0m \u001b[1mtarget:\u001b[0m  http://localhost:8000                                                                   \u001b[31m│\u001b[0m\r\n"]
